# The GLOBAL MOLA DEM (~2 GB) exceeds GitHub's 100 MB per-file limit — never commit it.
# Regenerate it with terratrace/scripts/fetch guidance, or crop a small committable
# sample with terratrace/scripts/make_mars_sample.py (committed as mola_sample*.tif).
terratrace/data/mars/mola_463m.tif
# Safety net: ignore any single raster that is very large.
terratrace/data/**/*_full.tif
# Fetched real Earth DEMs (several MB each) — regenerate with fetch_real_dems.py / the orchestrator.
terratrace/data/earth/
# Fetched real lunar DEMs (~41 MB each) — regenerate with terratrace/scripts/fetch_lola.py.
# The SHA-256 of the one used for the exploratory result is recorded in docs/LUNAR-DEMONSTRATION.md,
# so the file itself does not need to be in the repository.
terratrace/data/moon/
# Deck panels rendered from the project's own DEMs by terratrace/scripts/make_deck_assets.py.
# Regenerable, and ~2 MB of derived raster imagery; the script is the committed artifact.
assets/deck/
# Generated study bundles + showcase outputs (reproducible from a run; not source).
terratrace/artifacts/
demo/

# Python caches and environments
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Node (if a build is added later)
node_modules/

# Vercel
.vercel/

# Internal strategy/plan — kept local, not published to the public repo
Planetary-Analog-OS-Plan/
PLANETARY-ANALOG-OS-MASTER-PLAN.md
